{
  "name": "Omi 工具箱",
  "short_name": "工具箱",
  "description": "Omi 放在 GitHub Pages 的公開網站與工具入口。",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFFCF6",
  "theme_color": "#FFFCF6",
  "lang": "zh-TW",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
